rules_version = '2';

// Each landlord can only read and write their own tree: landlords/{uid} and
// every subcollection under it. Cloud Functions use the Admin SDK and bypass
// these rules. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /landlords/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
