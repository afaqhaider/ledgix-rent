# Copy to .env and fill in real values. Never commit .env.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_IOS=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# --- Add-on integrations (server-side only: set as Cloud Functions env / Secret Manager) ---
# "mock" (default) or "live". Live gateways need the approvals listed in the README.
EJARI_MODE=mock
MOLLAK_MODE=mock
UTILITY_MODE=mock
EMAIL_MODE=mock
# Feature flags (server): set to "false" to switch an integration off
FF_EJARI=true
FF_MOLLAK=true
FF_UTILITY_BILLS=true
FF_FORWARDING=true
# Public URL of the deployed quotePage function (used in work-order emails)
QUOTE_PAGE_URL=
# Credentials (owner adds real values; never commit)
DLD_GATEWAY_CLIENT_ID=
DLD_GATEWAY_CLIENT_SECRET=
UTILITY_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
